# Environment-specific configuration & secrets
# Files stay on localhost/server — never committed or pushed.
# **/ covers both the tsaci/ copy and the site copy at repo root.
**/config.php
**/db_credentials.php
**/mail_config.php
**/mail.ini

# Runtime session files (keep the protective .htaccess tracked)
**/sessions/*
!**/sessions/.htaccess

# OS / editor junk
.DS_Store
Thumbs.db

# Archives — site backups contain credential files
*.zip
