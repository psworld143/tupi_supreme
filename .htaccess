# No directory listings
Options -Indexes

# Security headers (silently skipped if mod_headers isn't loaded)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct web access to non-public file types anywhere under tsaci/
# (schema dumps, seeds, backups, archives, logs, configs, scripts).
<FilesMatch "(\.(sql|zip|bak|backup|ini|log|sh)$|^sess_)">
    Require all denied
</FilesMatch>

# Pre-2.4 fallback
<IfModule !mod_authz_core.c>
    <FilesMatch "(\.(sql|zip|bak|backup|ini|log|sh)$|^sess_)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
